        font-family: 'Courier New', ui-monospace, monospace;
        font-size: 7px;
        white-space: pre;
      }
      .row {
        opacity: 0;
        animation: revealRow 5.2s ease-in-out infinite;
      }
      @keyframes revealRow {
        0%   { opacity: 0; }
        4%   { opacity: 1; }
        75%  { opacity: 1; }
        92%  { opacity: 0.15; }
        100% { opacity: 0; }
      }
      .scanline {
        animation: moveScan 5.2s linear infinite;
      }
      @keyframes moveScan {
        0%   { transform: translateY(-10px); opacity: 0; }
        3%   { opacity: 1; }
        70%  { transform: translateY(505.2px); opacity: 1; }
        78%  { opacity: 0; }
        100% { opacity: 0; transform: translateY(-10px); }
      }
      .frame {
        fill: none;
        stroke: #36BCF7;
        stroke-opacity: 0.35;
        stroke-width: 1.5;
      }
